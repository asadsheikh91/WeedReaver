# Copy to .env. Every setting is prefixed WR_; app/core/config.py lists them all.
# Comments sit on their own lines: env_file parsers disagree about inline comments.

# ---- service
# development | test | production (docker-compose.yml forces production)
WR_ENVIRONMENT=development
WR_LOG_LEVEL=INFO
WR_LOG_JSON=false
# Swagger UI at /api/v1/docs
WR_DOCS_ENABLED=true

# ---- database: SQLite is fine for local development; production uses PostgreSQL
WR_DATABASE_URL=sqlite:///./weedreaver.db
# WR_DATABASE_URL=postgresql+psycopg://weedreaver:password@localhost:5432/weedreaver

# Used by docker-compose.yml
POSTGRES_USER=weedreaver
POSTGRES_PASSWORD=change-me
POSTGRES_DB=weedreaver

# ---- security. Production refuses to start with the default secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
WR_SECRET_KEY=change-me-in-production-this-is-not-a-secret
WR_ACCESS_TOKEN_MINUTES=15
WR_REFRESH_TOKEN_DAYS=60
WR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Where invitation and password-reset links point (the web dashboard)
WR_PUBLIC_WEB_URL=http://localhost:5173

# ---- storage: flight images, scan photos, orthomosaics, surfaces, exports
WR_STORAGE_DIR=./storage
WR_MAX_FLIGHT_IMAGE_MB=80
WR_MAX_SCAN_PHOTO_MB=12

# ---- clock
WR_STATION_TIMEZONE=Asia/Karachi
# Pin "today" to the demonstration date the field app and dashboard use. Development only;
# production refuses to start with it set.
# WR_DEMO_CLOCK_DATE=2027-01-22

# ---- processing pipeline. Swap in your own engines as "module:Class".
WR_ORTHOMOSAIC_ENGINE=app.pipeline.orthomosaic:SimulatedOrthomosaicEngine
WR_SEGMENTATION_ENGINE=app.pipeline.segmentation:SimulatedSegmentationEngine
# Run jobs inside the API process. Set false when running `python -m app.worker` separately.
WR_EMBEDDED_WORKER=true

# ---- OpenDroneMap. Start a node on this PC (images never leave it):
#   docker run -d --name nodeodm -p 3000:3000 opendronemap/nodeodm
# then switch the engine above to app.pipeline.orthomosaic:NodeODMOrthomosaicEngine.
WR_NODEODM_URL=http://localhost:3000
# WR_NODEODM_TOKEN=
# Orthophoto cm/px; unset = the flight's own GSD
# WR_ODM_ORTHOPHOTO_CM=1.0
# Extra ODM options (JSON), e.g. split a large flight for a node with little RAM:
# WR_ODM_OPTIONS={"split": 300, "split-overlap": 60}
WR_SIMULATED_PIPELINE_SECONDS=40

# ---- weather: static (the cached demo values) or open-meteo (live, no key needed)
WR_WEATHER_PROVIDER=static

# ---- mail for invitations and password resets: console | smtp
WR_MAIL_BACKEND=console
# WR_SMTP_HOST=smtp.example.com
# WR_SMTP_PORT=587
# WR_SMTP_USER=
# WR_SMTP_PASSWORD=
# WR_SMTP_FROM=WeedReaver <no-reply@example.com>
